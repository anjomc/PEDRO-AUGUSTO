* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f9f9f9;
    color: #333;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0;
}

.container {
    text-align: center;
    padding: 20px;
    background-color: #fff;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    max-width: 400px;
    width: 100%;
}

header h1 {
    color: #4CAF50;
    margin-bottom: 20px;
}

.links {
    display: flex;
    flex-direction: column;
}

.link-btn {
    background-color: #4CAF50;
    color: white;
    padding: 15px;
    margin: 10px 0;
    text-decoration: none;
    border-radius: 5px;
    transition: background-color 0.3s ease;
}

.link-btn:hover {
    background-color: #45a049;
}

footer {
    margin-top: 20px;
    font-size: 0.9em;
    color: #777;
}
